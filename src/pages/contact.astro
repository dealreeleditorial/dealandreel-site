---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Deal & Reel" description="Get in touch with the Deal & Reel editorial team.">
  <section class="page-header">
    <div class="container">
      <h1 class="page-title">Contact</h1>
      <p class="page-subtitle">Reach the Deal<span class="ampersand">&amp;</span>Reel editorial team.</p>
    </div>
  </section>
  <section class="contact-content">
    <div class="container--narrow">
      <div class="contact-grid">
        <div class="contact-card" id="contact-email">
          <div class="contact-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <h3>Email</h3>
          <a href="mailto:dealreel.editorial@gmail.com">dealreel.editorial@gmail.com</a>
          <p>For tips, corrections, press releases, and partnership inquiries.</p>
        </div>
        <div class="contact-card" id="contact-x">
          <div class="contact-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </div>
          <h3>X (Twitter)</h3>
          <a href="https://x.com/DealandReel" target="_blank" rel="noopener noreferrer">@DealandReel</a>
          <p>Follow us for breaking news and quick takes on the iGaming industry.</p>
        </div>
        <div class="contact-card" id="contact-telegram">
          <div class="contact-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          </div>
          <h3>Telegram</h3>
          <span class="coming-soon-text">Coming soon</span>
          <p>Our official Telegram channel is being set up. Stay tuned!</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { padding: var(--space-3xl) 0 var(--space-xl); border-bottom: 1px solid var(--color-border); background: var(--color-white); }
  .page-title { font-size: clamp(1.75rem, 4vw, 2.5rem); margin-bottom: var(--space-sm); }
  .page-subtitle { font-family: var(--font-sans); font-size: 1rem; color: var(--color-secondary); margin-bottom: 0; }
  .contact-content { padding: var(--space-2xl) 0 var(--space-3xl); }
  .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--space-xl); }
  .contact-card { padding: var(--space-2xl); border: 1px solid var(--color-border); background: var(--color-white); text-align: center; transition: all var(--transition-base); }
  .contact-card:hover { border-color: var(--color-accent); box-shadow: 0 8px 32px rgba(5, 32, 68, 0.06); transform: translateY(-3px); }
  .contact-icon { color: var(--color-accent); margin-bottom: var(--space-md); }
  .contact-card h3 { font-family: var(--font-serif); font-size: 1.2rem; color: var(--color-primary); margin-bottom: var(--space-sm); }
  .contact-card a { color: var(--color-accent); font-family: var(--font-sans); font-size: 0.9rem; font-weight: 500; text-decoration: underline; text-underline-offset: 3px; display: block; margin-bottom: var(--space-md); }
  .contact-card p { font-size: 0.85rem; color: var(--color-secondary); line-height: 1.6; margin-bottom: 0; }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const latestArticles = sortedArticles.slice(0, 3);

// Get unique categories
const categories = [...new Set(allArticles.map((a) => a.data.category))];

// Extract excerpt from article body (first ~200 chars)
function getExcerpt(body: string, maxLength = 200): string {
  const cleaned = body
    .replace(/^---[\s\S]*?---/, '')
    .replace(/##?\s+.+/g, '')
    .replace(/\n+/g, ' ')
    .trim();
  return cleaned.length > maxLength
    ? cleaned.slice(0, maxLength).trimEnd() + '…'
    : cleaned;
}
---

<BaseLayout title="Deal & Reel — The Global iGaming Industry Wire">

  <!-- Hero Section -->
  <section class="hero" id="hero-section">
    <div class="container">
      <div class="hero-content">
        <div class="hero-logo">
          <img src="/logo.png" alt="Deal & Reel" class="hero-logo-img" />
        </div>
        <p class="hero-tagline">Expert analysis, regulatory intelligence, and market insights<br />for the worldwide iGaming industry.</p>
        <div class="hero-divider">
          <span class="hero-ampersand">&amp;</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Articles -->
  <section class="section" id="latest-articles">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Latest Articles</h2>
        <a href="/articles" class="section-link">View all <span aria-hidden="true">→</span></a>
      </div>
      <div class="articles-featured">
        {latestArticles.map((article, i) => (
          <ArticleCard
            title={article.data.title}
            slug={article.data.slug}
            category={article.data.category}
            date={article.data.date}
            excerpt={getExcerpt(article.body || '')}
            featured={i === 0}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="section section--alt" id="categories-section">
    <div class="container">
      <h2 class="section-title">Categories</h2>
      <div class="categories-grid">
        {categories.map((cat) => (
          <a href={`/articles?category=${encodeURIComponent(cat)}`} class="category-card">
            <span class="category-card__name">{cat}</span>
            <span class="category-card__count">
              {allArticles.filter((a) => a.data.category === cat).length} article{allArticles.filter((a) => a.data.category === cat).length !== 1 ? 's' : ''}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-4xl) 0 var(--space-3xl);
    text-align: center;
    background: linear-gradient(180deg, var(--color-white) 0%, var(--color-bg) 100%);
  }

  .hero-content {
    max-width: 640px;
    margin: 0 auto;
  }

  .hero-logo {
    margin-bottom: var(--space-xl);
  }

  .hero-logo-img {
    height: 72px;
    width: auto;
    margin: 0 auto;
  }

  .hero-tagline {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.7;
    color: var(--color-secondary);
    margin-bottom: var(--space-xl);
  }

  .hero-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
  }

  .hero-divider::before,
  .hero-divider::after {
    content: '';
    height: 1px;
    width: 80px;
    background: var(--color-border);
  }

  .hero-ampersand {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    color: var(--color-accent);
    font-style: italic;
    line-height: 1;
  }

  /* ── Sections ── */
  .section {
    padding: var(--space-3xl) 0;
  }

  .section--alt {
    background: var(--color-white);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-xl);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-primary);
    position: relative;
    padding-bottom: var(--space-sm);
  }

  .section-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 40px;
    height: 3px;
    background: var(--color-accent);
  }

  .section-link {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    transition: gap var(--transition-fast);
  }

  .section-link:hover {
    gap: 0.6em;
    color: var(--color-accent);
  }

  /* ── Categories Grid ── */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .category-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    transition: all var(--transition-base);
    text-decoration: none;
  }

  .category-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 16px rgba(5, 32, 68, 0.06);
    transform: translateY(-2px);
  }

  .category-card__name {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
  }

  .category-card:hover .category-card__name {
    color: var(--color-accent);
  }

  .category-card__count {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-secondary);
  }

  /* ── Articles Featured ── */
  .articles-featured {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 768px) {
    .hero-logo-img {
      height: 56px;
    }

    .hero-tagline {
      font-size: 0.95rem;
    }

    .section-header {
      flex-direction: column;
      gap: var(--space-sm);
    }
  }
</style>
